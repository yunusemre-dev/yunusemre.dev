# Optional. Without it, the site uses a small grounded local responder.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Required in production. Use a long random value.
ADMIN_PASSWORD=change-me

DATA_DIR=./data
COOKIE_SECURE=1
BOT_CHECK_DIFFICULTY=13
GEOLOCATION_URL_TEMPLATE=https://ipapi.co/{ip}/json/
PUSH_CONTACT=mailto:yunus.emre.kepenek@outlook.com

# Production gallery backups. Keep credentials outside Git.
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=yunusemre-dev-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_PREFIX=portfolio
R2_BACKUP_REQUIRED=0
