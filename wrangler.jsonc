{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yunusemre-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "www.yunusemre.dev",
      "custom_domain": true
    },
    {
      "pattern": "yunusemre.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yunusemre-dev",
      "database_id": "924654cb-ef37-4b1a-8b4e-a0d4f943eefb",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "yunusemre-dev-backups"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-luna",
    "BOT_CHECK_DIFFICULTY": "13",
    "R2_MEDIA_PREFIX": "portfolio/uploads",
    "VAPID_SUBJECT": "mailto:yunus.emre.kepenek@outlook.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
